<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Dimmer</string>

    <!-- 门界面 -->
    <string name="gate_title">需要一次 adb 授权</string>
    <string name="gate_body">Dimmer 通过系统接口调暗屏幕，需要 WRITE_SECURE_SETTINGS 权限。该权限无法在手机上申请，需在电脑上执行一次 adb 命令。</string>
    <string name="gate_alt_title">推荐：重装授权</string>
    <string name="gate_alt_badge">ColorOS 必选</string>
    <string name="gate_alt_body">-r 保留数据，-g 安装时直接授予权限。将 &lt;apk路径&gt; 替换为实际 APK 路径。</string>
    <string name="gate_std_title">标准方式</string>
    <string name="gate_std_body">其它 ROM 可尝试；ColorOS 通常会拒绝。</string>
    <string name="gate_footnote">前提：电脑已安装 platform-tools，手机已开启 USB 调试。多设备时在 adb 后加 -s &lt;序列号&gt;。撤销：adb shell pm revoke dev.dimmer.app android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="btn_recheck">我已授权，重新检测</string>
    <string name="copy_command">复制命令</string>
    <string name="msg_copied">已复制</string>
    <string name="msg_copy_failed">复制失败，请长按命令文本手动复制</string>

