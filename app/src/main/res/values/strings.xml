    <!-- 警示条 -->
    <string name="banner_title">系统滑块正在介入</string>
    <string name="banner_text">系统「降低白点值」滑块不在 0%，会把强度压回 50 以内。建议把它拖回 0%。</string>
    <string name="banner_title_extoff">调暗已被外部关闭</string>
    <string name="banner_text_extoff">不是系统滑块造成的。点「仍然应用」可重新写入。</string>
